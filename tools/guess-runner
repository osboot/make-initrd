#!/bin/bash -eu
# SPDX-License-Identifier: GPL-3.0-or-later

. sh-functions
. guess-functions

PROG="${0##*/}"

show_usage() {
	local rc="${1:-0}"
	cat <<EOF
Usage: $PROG [options]

Options:
  --modules=LIST       Initial guess modules to run
  --disabled=LIST      Modules to skip (DISABLE_GUESS)
  --triggers=LIST      Feature-to-guess-modules trigger mappings
  -v, --verbose        Verbose output
  -h, --help           Display this help and exit
EOF
	exit "$rc"
}

initial_modules=
disabled_list=
triggers_list=
common_scripts=
verbose=

GETOPT_ALLOW_ABBREV=
TEMP="$(getopt -n "$PROG" -o "v,h" -l "modules:,disabled:,triggers:,common-scripts:,guessdir:,detectdir:,features-dir:,verbose,help" -- "$@")" ||
	show_usage 1
eval set -- "$TEMP"

while :; do
	case "$1" in
		--modules) shift
			initial_modules="$1"
			;;
		--disabled) shift
			disabled_list="$1"
			;;
		--triggers) shift
			triggers_list="$1"
			;;
		--common-scripts) shift
			common_scripts="$1"
			;;
		--guessdir) shift
			GUESSDIR="$1"
			;;
		--detectdir) shift
			DETECTDIR="$1"
			;;
		--features-dir) shift
			FEATURESDIR="$1"
			;;
		-v|--verbose)
			verbose=1
			;;
		-h|--help)
			show_usage 0
			;;
		--)
			shift
			break
			;;
		*)
			fatal "$PROG: unrecognized option: $1"
			;;
	esac
	shift
done

FEATURESDIR="${FEATURESDIR:-${PROJECTDIR:-.}/features}"
DETECTDIR="${DETECTDIR:-${PROJECTDIR:-.}/guess}"
common_scripts="${common_scripts:-${GUESS_COMMON_SCRIPTS-}}"

[ -n "${GUESSDIR-}" ] || fatal "$PROG: GUESSDIR is not set"
export GUESSDIR
mkdir -p -- "$GUESSDIR"
[ -f "$GUESSDIR/guess.tsv" ] || : > "$GUESSDIR/guess.tsv"

declare -A alias_map=(
	["device"]="modules-blockdev"
	["device-tree"]="modules-device-tree"
	["keyboard"]="modules-keyboard"
	["net"]="modules-network"
	["root"]="rootfs"
	["touchscreen"]="modules-touchscreen"
)
declare -A rev_alias_map=(
	["modules-blockdev"]="device"
	["modules-device-tree"]="device-tree"
	["modules-keyboard"]="keyboard"
	["modules-network"]="net"
	["rootfs"]="root"
	["modules-touchscreen"]="touchscreen"
)

declare -A visited_modules=()
declare -A disabled_modules=()
declare -A active_features=()
declare -A feature_triggers=()
declare -a queue=()

for mod in $disabled_list; do
	[ -n "$mod" ] || continue
	disabled_modules["$mod"]=1
	[ -z "${alias_map[$mod]-}" ] || disabled_modules["${alias_map[$mod]}"]=1
	[ -z "${rev_alias_map[$mod]-}" ] || disabled_modules["${rev_alias_map[$mod]}"]=1
done

# triggers_list format: "feat1:mod1,mod2 feat2:mod3" or "feat1:mod1 feat1:mod2"
for pair in ${triggers_list:-${FEATURE_REQUIRES_GUESS-}}; do
	[ -n "$pair" ] || continue
	feat="${pair%%:*}"
	mods="${pair#*:}"
	mods="${mods//,/ }"
	feature_triggers["$feat"]="${feature_triggers[$feat]:+${feature_triggers[$feat]} }$mods"
done

# Initialize active features from environment
for feat in ${ALL_ACTIVE_FEATURES-}; do
	[ -n "$feat" ] || continue
	active_features["$feat"]=1
done

for mod in $initial_modules; do
	[ -n "$mod" ] || continue
	canon_mod="${alias_map[$mod]:-$mod}"
	[ -z "${disabled_modules[$canon_mod]-}" ] || continue
	[ -z "${disabled_modules[$mod]-}" ] || continue
	queue+=("$canon_mod")
done

# Check if any initially active features trigger modules
for feat in "${!active_features[@]}"; do
	trigs="${feature_triggers[$feat]-}"
	[ -n "$trigs" ] || continue
	for trig in $trigs; do
		tmod="${trig%%:*}"
		tparams="${trig#*:}"
		if [ "$tparams" != "$trig" ]; then
			eval "export $tparams"
		fi
		canon_tmod="${alias_map[$tmod]:-$tmod}"
		[ -z "${disabled_modules[$canon_tmod]-}" ] || continue
		[ -z "${disabled_modules[$tmod]-}" ] || continue
		queue+=("$canon_tmod")
	done
done

iteration=0
max_iterations=10

while [ "${#queue[@]}" -gt 0 ]; do
	iteration=$((iteration + 1))
	if [ "$iteration" -gt "$max_iterations" ]; then
		fatal "$PROG: Exceeded maximum guess iterations limit ($max_iterations)"
	fi

	current_batch=("${queue[@]}")
	queue=()

	export GUESS_ITERATION="$iteration"

	for mod in "${current_batch[@]}"; do
		canon_mod="${alias_map[$mod]:-$mod}"
		[ -z "${visited_modules[$canon_mod]-}" ] || continue
		[ -z "${disabled_modules[$canon_mod]-}" ] || continue
		[ -z "${disabled_modules[$mod]-}" ] || continue
		visited_modules["$canon_mod"]=1
		visited_modules["$mod"]=1

		if [ "$canon_mod" = "common" ]; then
			if [ -n "$verbose" ]; then
				msg-timestamp "Processing guess-common ..."
			fi
			export GUESS_MODULE_NAME="guess-common"
			export GUESS_SUFFIX="add:guess-common"
			for m in $common_scripts; do
				[ ! -x "$m" ] || "$m"
			done
			continue
		fi

		action_script=""
		target_mod="$canon_mod"

		if [ -x "$FEATURESDIR/$canon_mod/guess/action" ]; then
			action_script="$FEATURESDIR/$canon_mod/guess/action"
		elif [ -x "$FEATURESDIR/$mod/guess/action" ]; then
			action_script="$FEATURESDIR/$mod/guess/action"
			target_mod="$mod"
		elif [ -x "$DETECTDIR/$mod/action" ]; then
			action_script="$DETECTDIR/$mod/action"
			target_mod="$mod"
		elif [ -n "${rev_alias_map[$mod]-}" ] && [ -x "$DETECTDIR/${rev_alias_map[$mod]}/action" ]; then
			action_script="$DETECTDIR/${rev_alias_map[$mod]}/action"
			target_mod="${rev_alias_map[$mod]}"
		fi

		if [ -z "$action_script" ]; then
			continue
		fi

		export GUESS_MODULE_NAME="guess-$target_mod"
		export GUESS_SUFFIX="add:guess-$target_mod"
		case "$target_mod" in
			keyboard|modules-keyboard|touchscreen|modules-touchscreen)
				export GUESS_SUFFIX="rescue:guess-$target_mod"
				;;
		esac

		if [ -n "$verbose" ]; then
			msg-timestamp "Processing guess-$target_mod ..."
		fi

		"$action_script"
	done

	# Check for newly activated features in guess.tsv
	new_features=()
	if [ -f "$GUESSDIR/guess.tsv" ]; then
		while IFS=$'\t' read -r kind feat _; do
			[ "$kind" = "feature" ] || continue
			[ -n "$feat" ] || continue
			[ -z "${active_features[$feat]-}" ] || continue
			active_features["$feat"]=1
			new_features+=("$feat")
		done < "$GUESSDIR/guess.tsv"
	fi

	# Export updated ALL_ACTIVE_FEATURES for scripts using is_active_feature
	export ALL_ACTIVE_FEATURES="${!active_features[*]}"

	# Trigger dependent modules
	for feat in "${new_features[@]}"; do
		trigs="${feature_triggers[$feat]-}"
		[ -n "$trigs" ] || continue

		for trig in $trigs; do
			tmod="${trig%%:*}"
			tparams="${trig#*:}"
			if [ "$tparams" != "$trig" ]; then
				eval "export $tparams"
			fi
			canon_tmod="${alias_map[$tmod]:-$tmod}"
			[ -z "${disabled_modules[$canon_tmod]-}" ] || continue
			[ -z "${disabled_modules[$tmod]-}" ] || continue
			visited_modules["$canon_tmod"]=""
			visited_modules["$tmod"]=""
			queue+=("$canon_tmod")
		done
	done
done
