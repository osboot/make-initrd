AUTODETECT ?= all

ifeq ($(MAKECMDGOALS),guess-modules)
AUTODETECT := root device
endif

-include $(GUESSDIR)/guessed.mk

GUESS_ALIAS_device      = modules-blockdev
GUESS_ALIAS_device-tree = modules-device-tree
GUESS_ALIAS_keyboard    = modules-keyboard
GUESS_ALIAS_net         = modules-network
GUESS_ALIAS_root        = rootfs
GUESS_ALIAS_touchscreen = modules-touchscreen

resolve-guess-module = $(or $(GUESS_ALIAS_$(1)),$(1))

RESOLVED_DISABLE_GUESS = $(sort $(DISABLE_GUESS) $(foreach m,$(DISABLE_GUESS),$(GUESS_ALIAS_$(m))))

ALL_FEATURE_GUESS_ACTIONS = $(wildcard $(FEATURESDIR)/*/guess/action)
ALL_FEATURE_GUESS_MODULES = $(patsubst $(FEATURESDIR)/%/guess/action,%,$(ALL_FEATURE_GUESS_ACTIONS))
ALL_DETECTDIR_MODULES = $(notdir $(call filter-dirs,$(wildcard $(DETECTDIR)/*)))
ALL_AVAILABLE_GUESS_MODULES = $(sort common $(ALL_FEATURE_GUESS_MODULES) $(ALL_DETECTDIR_MODULES))

GUESS_CONFIG_MODULES = \
	$(foreach mod1, \
		$(if $(findstring all,$(AUTODETECT)), \
			$(realpath $(wildcard $(DETECTDIR)/*)), \
			$(foreach mod,$(AUTODETECT),$(realpath $(DETECTDIR)/$(mod)))), \
		$(wildcard $(mod1)/config.mk))

GUESS_MODULES = \
	$(sort $(filter-out $(RESOLVED_DISABLE_GUESS), \
		$(if $(findstring all,$(AUTODETECT)), \
			$(ALL_AVAILABLE_GUESS_MODULES), \
			$(foreach mod,$(AUTODETECT),$(call resolve-guess-module,$(mod))))))

-include $(GUESS_CONFIG_MODULES)

GUESS_DEVICE_SCRIPTS = $(call wildcard-features,guess/device)
GUESS_FSTYPE_SCRIPTS = $(call wildcard-features,guess/fstype)
GUESS_COMMON_SCRIPTS = $(call wildcard-features,guess/common)
ALL_ACTIVE_FEATURES := $(call get-all-active-features)

PHONY += prepare-guess

prepare-guess: check-for-root
	@mkdir $(verbose3) -m 755 -p -- $(GUESSDIR)

PHONY += test-guess-actions

test-guess-actions: prepare-guess
	@[ -n "$(TEST_GUESS_ACTIONS)" ] || { printf "TEST_GUESS_ACTIONS not specified\n" >&2; exit 1; }
	@for exe in $(TEST_GUESS_ACTIONS); do echo "RUN: $$exe"; "$$exe"; done

unknown_features = \
	$(filter-out \
		$(notdir $(wildcard $(FEATURESDIR)/*)), \
		$(sort $(FEATURES)))

ifneq ($(unknown_features),)
$(info WARNING: Unknown features are specified in the config: $(unknown_features))
endif

PHONY += depmod-host

depmod-host: check-for-root
	@:
ifeq ($(IGNORE_DEPMOD),)
	@$(VMSG) "Generating module dependencies on host ..."
	@depmod -a $(if $(KERNEL_SYSTEM_MAP),-F "$(KERNEL_SYSTEM_MAP)") "$(KERNEL)"
endif

PHONY += guess guess-run

guess-run: prepare-guess
	@$(VMSG) "Guessing config ..."
	@$(TOOLSDIR)/guess-runner \
		$(if $(VERBOSE),-v) \
		--features-dir="$(FEATURESDIR)" \
		--common-scripts="$(GUESS_COMMON_SCRIPTS)" \
		--modules="$(notdir $(GUESS_MODULES))" \
		--disabled="$(DISABLE_GUESS)"
	@$(VMSG) "Collection of guessed parameters ..."
	@$(TOOLSDIR)/guess-config > $(GUESSDIR)/guessed.mk

guess: guess-run depmod-host
	@$(VMSG) "Guessing is complete"
