#!/bin/bash

ks_requires_reboot=("reboot")
ks_requires_halt=("halt")
ks_requires_poweroff=("halt")
ks_requires_shutdown=("halt")
ks_requires_ks_reboot_eject=("eject")
ks_requires_ks_reboot_kexec=("reboot")
ks_reboot()
{
	local PROG TEMP cmd
	local try_eject='' try_kexec=''

	PROG="kickstart"
	message "command: ${FUNCNAME[0]} $*"

	PROG="${FUNCNAME[0]}"
	TEMP=`getopt -n "$PROG" -l 'eject,kexec' -- "$PROG" "$@"` ||
		return 1
	eval set -- "$TEMP"

	while :; do
		case "$1" in
			--) shift; break
				;;
			--eject) try_eject=1
				;;
			--kexec) try_kexec=1
				;;
		esac
		shift
	done

	ks_check_requires "$1" ||
		return 1
	[ -z "$try_eject" ] || ks_check_requires ks_reboot_eject ||
		return 1
	[ -z "$try_kexec" ] || ks_check_requires ks_reboot_kexec ||
		return 1

	ks_umount
	[ -z "$try_eject" ] || eject ||:
	[ -z "$try_kexec" ] || command reboot -f -d -k ||:
	command "$@"
}

reboot()   { ks_reboot "$@" -- reboot -f -d; }
halt()     { ks_reboot "$@" -- halt -f -p;   }
poweroff() { ks_reboot "$@" -- halt -f -p;   }
shutdown() { ks_reboot "$@" -- halt -f -p;   }

