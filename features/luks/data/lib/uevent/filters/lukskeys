#!/bin/bash

. /.initrd/initenv
. uevent-sh-functions
. initrd-sh-functions

split() {
	local IFS=:
	set -- $1
	if [ "$1" = "pkcs11" ]; then
		is_pkcs11='true'
		path="$2"

	else
		path="$1"
		keydev="${2-}"
	fi

	luksdev="${3-}"
}

add_key() {
	local entry
	printf -v entry '%s\t%s\t%s' "$1" "$2" "$3"
	grep -qsFx -- "$entry" /etc/luks.keys 2>/dev/null ||
		printf '%s\n' "$entry" >> /etc/luks.keys
}

process_keys() {
	local i=0 path keydev luksdev is_pkcs11 realdev

	while [ "$i" -lt "$LUKS_KEY" ]; do
		path='' keydev='' luksdev='' is_pkcs11=''
		eval "split \"\$LUKS_KEY$i\""
		i=$(( $i + 1 ))

		if [ -n "$is_pkcs11" ]; then
			[ -n "$path" ] || continue
			add_key "pkcs11:$path" "" "$luksdev"
			continue
		fi

		[ -n "$keydev" ] ||
			continue
		realdev=
		get_dev realdev "$keydev" ||
			continue
		add_key "$path" "$realdev" "$luksdev"
	done
}

[ -z "${NO_LUKS-}" ] ||
	exit 0

[ -n "$LUKS_KEY" ] && [ "$LUKS_KEY" != 0 ] ||
	exit 0

run_locked /etc/luks.keys process_keys
