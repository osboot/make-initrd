#!/bin/bash

[ ! -f /.initrd/initenv ] || . /.initrd/initenv

. shell-error
. uevent-sh-functions
. network-sh-functions

PROG="${QUEUE:--}: session=${SESSION:-0}: $PROG"
message_time=1

dhcp_packets_pause=5
dhcp_number_packets=3
piddir="${net_piddir:-/var/run}"
logdir="${net_logdir:-/var/log}"
net_handlerdir="${net_handlerdir:-/lib/network}"

need_dhcp()
{
	local n
	for n in "ifaces/$NET_IF" "default"; do
		[ ! -e "$net_confdir/$n/ipv${ip_version}dhcp" ] ||
			return 0
	done
	return 1
}

is_dhcp_running()
{
	local pidfile="$1" pid=''

	[ -f "$pidfile" ] ||
		return 1

	{ read -r pid < "$pidfile" ||:; } >/dev/null 2>&1

	if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
		return 0
	fi

	rm -f -- "$pidfile"
	return 1
}

run_dhcp()
{
	local pidfile="$piddir/udhcpc$ip_version.$NET_IF.pid"

	! is_dhcp_running "$pidfile" && need_dhcp ||
		return 1

	[ "$ip_version" != 6 ] ||
		load_ipv6

	ipv${ip_version}_enabled ||
		return 1

	mkdir -p -- "$piddir" "$logdir"

	set -- "$1" -v -n \
		-i "$NET_IF" \
		-t "$dhcp_number_packets" \
		-T "$dhcp_packets_pause" \
		-s "$net_handlerdir/udhcpc$ip_version.script" \
		-p "$pidfile"

	message "$NET_IF: starting dhcp$ip_version: $*"

	"$@" >>"$logdir/udhcpc$ip_version.$NET_IF.log" 2>&1 &
}

start_dhcp()
{
	local ip_version cmd

	for ip_version in 4 6; do
		case "$ip_version" in
			4) cmd=udhcpc ;;
			6) cmd=udhcpc6 ;;
		esac
		run_dhcp "$cmd" ||:
	done
}

stop_dhcp()
{
	local ip_version pidfile pid

	for ip_version in 4 6; do
		pidfile="$piddir/udhcpc$ip_version.$NET_IF.pid"
		pid=
		{ read -r pid < "$pidfile" ||:; } >/dev/null 2>&1

		[ -z "$pid" ] ||
			kill "$pid" 2>/dev/null ||:

		rm -f -- "$pidfile"
	done
}

handler()
{
	! is_loopback "$NET_IF" ||
		return 0

	case "$ev_type.$ev_action" in
		carrier.up)
			start_dhcp
			;;
		config.update)
			[ ! -e "$net_statedir/up/$NET_IF/carrier" ] ||
				start_dhcp
			;;
		carrier.down|config.remove)
			stop_dhcp
			;;
	esac
}

for ev_type in carrier config; do
	for e in "$1/network.$ev_type".*; do
		[ -e "$e" ] || break

		ev_action="${e##*/network.$ev_type.}"
		ev_action="${ev_action%%.*}"

		( . "$e"; handler; ) ||:
	done
done
