#!/bin/bash

if [ -z "${__initrd_sh_functions-}" ]; then
__initrd_sh_functions=1

omit_pid() {
	: > "/.initrd/killall/$1"
}

devlinks_check() {
	local l
	for l in ${DEVLINKS-}; do
		[ "$1" != "$l" ] ||
			return 0
	done
	return 1
}

get_majmin() {
	local v
	v="$(stat -L -c '%02t:%02T' "$1" 2>/dev/null)" &&
		printf '%d:%d\n' "0x${v%:*}" "0x${v#*:}" ||
		return 1
}

get_dev() {
	local name retval value

	if [ "$#" = 2 ]; then
		retval="$1"; shift
	fi
	name="$1"; shift

	case "$name" in
		'')
			return 1
			;;
		UUID=*)
			[ "${ID_FS_UUID-}" = "${name#UUID=}" ] ||
				return 1
			;;
		LABEL=*)
			[ "${ID_FS_LABEL-}" = "${name#LABEL=}" ] ||
				return 1
			;;
		PARTUUID=*)
			[ "${ID_PART_ENTRY_UUID-}" = "${name#PARTUUID=}" ] ||
				return 1
			;;
		PARTLABEL=*)
			[ "${ID_PART_ENTRY_NAME-}" = "${name#PARTLABEL=}" ] ||
				return 1
			;;
		SERIAL=*)
			[ "${ID_SERIAL-}" = "${name#SERIAL=}" ] ||
				return 1
			;;
		/dev/disk/by-uuid/*)
			[ "/dev/disk/by-uuid/${ID_FS_UUID_ENC-}" = "$name" ] ||
				return 1
			;;
		/dev/disk/by-label/*)
			[ "/dev/disk/by-label/${ID_FS_LABEL_ENC-}" = "$name" ] ||
				return 1
			;;
		/dev/disk/by-partuuid/*)
			[ "/dev/disk/by-partuuid/${ID_PART_ENTRY_UUID-}" = "$name" ] ||
				return 1
			;;
		/dev/disk/by-partlabel/*)
			[ "/dev/disk/by-label/${ID_PART_ENTRY_NAME-}" = "$name" ] ||
				return 1
			;;
		/dev/block/[0-9]*:[0-9]*)
			[ "/dev/block/${MAJOR-}:${MINOR-}" = "$name" ] ||
				return 1
			;;
		/*)
			[ "${DEVNAME-}" = "$name" ] || devlinks_check "$name" ||
				return 1
			;;
		*:*)
			[ "${MAJOR-}" = "${name%:*}" ] && [ "${MINOR-}" = "${name#*:}" ] ||
				return 1
			;;
		*)
			( _=$(( 0x$name )) ) 2>/dev/null ||
				return 1
			value=$(( 0x$name ))
			[ "${MAJOR-}" = "$(( $value / 256 ))" ] && [ "${MINOR-}" = "$(( $value % 256 ))" ] ||
				return 1
			;;
	esac
	[ -n "${DEVNAME-}" ] ||
		return 1
	[ -z "$retval" ] ||
		eval "$retval=\"\$DEVNAME\""
}

readline()
{
        local __v=
        # shellcheck disable=SC2162
        read __v < "$2" ||:
        eval "$1=\"\$__v\""
}

write_atomic()
{
	local __write_atomic_dst="$1"
	local __write_atomic_tmp="$1.$$.$BASHPID"
	local __write_atomic_rc=0
	shift

	if [ "$#" -gt 0 ]; then
		"$@" > "$__write_atomic_tmp" || __write_atomic_rc=$?
	else
		cat > "$__write_atomic_tmp" || __write_atomic_rc=$?
	fi

	if [ "$__write_atomic_rc" -eq 0 ]; then
		mv -f -- "$__write_atomic_tmp" "$__write_atomic_dst"
	else
		rm -f -- "$__write_atomic_tmp"
		return "$__write_atomic_rc"
	fi
}

current_seconds()
{
	local __v=
	__v="$("${TIMESTAMP:-timestamp}" boottime raw 2>/dev/null)" ||:
	__v="${__v%.*}"
	eval "$1=\"\$__v\""
}

rootdelay_pause_lock="${rootdelay_pause_lock:-/.initrd/rootdelay/pause.lock}"
_rootdelay_pause_time="${_rootdelay_pause_time:-/.initrd/rootdelay/pause.time}"
_rootdelay_reset="${_rootdelay_reset:-/.initrd/rootdelay/reset}"
_rootdelay_timestamp="${_rootdelay_timestamp:-/.initrd/rootdelay/deadline}"

_rootdelay_finalize_pause()
{
	local chk_fd pause_start reset_time now paused_duration deadline

	[ -e "$rootdelay_pause_lock" ] || return 0

	exec {chk_fd}<"$rootdelay_pause_lock"
	if ! flock -n -x "$chk_fd"; then
		exec {chk_fd}<&-
		return 1
	fi

	if [ -f "$_rootdelay_pause_time" ]; then
		readline pause_start "$_rootdelay_pause_time"

		if [ -f "$_rootdelay_reset" ]; then
			readline reset_time "$_rootdelay_reset"
			rm -f "$_rootdelay_reset"

			if [ -n "$reset_time" ] && [ -n "$pause_start" ] && [ "$reset_time" -gt "$pause_start" ]; then
				pause_start="$reset_time"
			fi
		fi

		if [ -n "$pause_start" ] && [ -f "$_rootdelay_timestamp" ]; then
			current_seconds now
			paused_duration=$(( $now - $pause_start ))

			if [ "$paused_duration" -gt 0 ]; then
				readline deadline "$_rootdelay_timestamp"

				if [ -n "$deadline" ] && [ "$deadline" -gt 0 ]; then
					rootdelay_set_deadline "$(( $deadline + $paused_duration ))"
				fi
			fi
		fi

		rm -f "$_rootdelay_pause_time"
	fi

	exec {chk_fd}<&-
}

run_rootdelay_paused()
{
	local fd rc=0 now

	mkdir -p -- "${rootdelay_pause_lock%/*}"
	touch "$rootdelay_pause_lock"

	exec {fd}<"$rootdelay_pause_lock"
	flock -s "$fd"

	if [ ! -f "$_rootdelay_pause_time" ]; then
		current_seconds now
		write_atomic "$_rootdelay_pause_time" printf '%s\n' "$now"
	fi

	"$@" {fd}<&- || rc=$?
	exec {fd}<&-

	_rootdelay_finalize_pause

	return $rc
}

rootdelay_pause()
{
	local now

	[ -z "${rootdelay_pause_fd-}" ] || return 0

	mkdir -p -- "${rootdelay_pause_lock%/*}"
	touch "$rootdelay_pause_lock"

	exec {rootdelay_pause_fd}<"$rootdelay_pause_lock"
	flock -s "$rootdelay_pause_fd"

	if [ ! -f "$_rootdelay_pause_time" ]; then
		current_seconds now
		write_atomic "$_rootdelay_pause_time" printf '%s\n' "$now"
	fi
}

rootdelay_unpause()
{
	[ -n "${rootdelay_pause_fd-}" ] || return 0

	exec {rootdelay_pause_fd}<&-
	rootdelay_pause_fd=

	_rootdelay_finalize_pause
}

rootdelay_paused()
{
	local fd rc=0

	[ -z "${rootdelay_pause_fd-}" ] || return 0
	[ -e "$rootdelay_pause_lock"  ] || return 1

	exec {fd}<"$rootdelay_pause_lock"

	! flock -n -x "$fd" || rc=1
	exec {fd}<&-

	return $rc
}

rootdelay_set_deadline()
{
	mkdir -p -- "${_rootdelay_timestamp%/*}"
	write_atomic "$_rootdelay_timestamp" printf '%s\n' "$1"
}

rootdelay_reset_timer()
{
	local now="${1-}"

	if [ -z "$now" ]; then
		current_seconds now
	fi

	rootdelay_set_deadline "$(( $now + ${ROOTDELAY:-0} ))"

	if rootdelay_paused; then
		mkdir -p -- "${_rootdelay_reset%/*}"
		write_atomic "$_rootdelay_reset" printf '%s\n' "$now"
	fi
}

initrd_features=/.initrd/features

has_feature()
{
	while [ "$#" -gt 0 ]; do
		[ -d "$initrd_features/$1" ] ||
			return 1
		shift
	done
}

_resume_checked=/.initrd/resume/checked

set_resume_checked()
{
	mkdir -p -- "$_resume_checked"
}

resume_checked()
{
	[ -n "${NORESUME-}" ] || [ -z "${RESUME-}" ] || [ -e "$_resume_checked" ] ||
		return 1
}

. shell-locks

lock_file_fd=

lock_file()
{
	exec {lock_file_fd}<"$1"
	shift
	flock "$@" "$lock_file_fd"
}

unlock_file()
{
	[ -n "${lock_file_fd-}" ] || return 0
	fd_unlock "$lock_file_fd"
	lock_file_fd=
}

run_locked()
{
	local lock_file_fd='' rc=0

	lock_file "$1" -x
	shift
	"$@" {lock_file_fd}<&- || rc=$?
	unlock_file

	return $rc
}

run_rlocked()
{
	local lock_file_fd='' rc=0

	lock_file "$1" -s
	shift
	"$@" {lock_file_fd}<&- || rc=$?
	unlock_file

	return $rc
}

console_lock_file="${console_lock_file:-/.initrd/console.lock}"

console_lock()
{
	lock_file "$console_lock_file" -x
}

console_unlock()
{
	unlock_file
}

run_console_locked()
{
	run_locked "$console_lock_file" "$@"
}

fstab_lock_file="${fstab_lock_file:-/.initrd/fstab.lock}"

fstab_lock()
{
	lock_file "$fstab_lock_file" -x
}

fstab_rlock()
{
	lock_file "$fstab_lock_file" -s
}

fstab_unlock()
{
	unlock_file
}

run_fstab_locked()
{
	run_locked "$fstab_lock_file" "$@"
}

run_fstab_rlocked()
{
	run_rlocked "$fstab_lock_file" "$@"
}

fi
