#!/bin/bash -efu
# SPDX-License-Identifier: GPL-3.0-or-later

tmpdir="$(mktemp -d)"
trap 'rm -rf "$tmpdir"' EXIT

export GUESSDIR="$tmpdir/guess"
mkdir -p "$GUESSDIR"
export PATH="$PWD/.build/dest/usr/bin:$PWD/.build/dest/usr/sbin:$PWD/tools:$PATH"

cat > "$GUESSDIR/guess.tsv" <<EOF
feature	add-udev-rules	-	guess-common	-
feature	cleanup	-	guess-common	-
feature	compress	-	guess-common	-
feature	rdshell	-	guess-rdshell	-
feature	rootfs	-	guess-root	-
module	add	ext4	guess-root	mount /
opt-module	add	virtio_balloon	guess-qemu	-
variable	MOUNTPOINTS	/	guess-root	-
EOF

tools/guess-explain
