#!/bin/bash -efu
# SPDX-License-Identifier: GPL-3.0-or-later

tmpdir="$(mktemp -d)"
trap 'rm -rf "$tmpdir"' EXIT

mkdir -p "$tmpdir/guess"
mkdir -p "$tmpdir/sys/devices/pci0000:00/0000:00:01.0/block/sda/sda1"
mkdir -p "$tmpdir/sys/devices/pci0000:00/0000:00:01.0/block/sda/sda2"
echo "pci:parent_bridge" > "$tmpdir/sys/devices/pci0000:00/0000:00:01.0/modalias"
echo "scsi:disk" > "$tmpdir/sys/devices/pci0000:00/0000:00:01.0/block/sda/modalias"

export PATH="$PWD/.build/dest/usr/bin:$PWD/.build/dest/usr/sbin:$PWD/tools:$PATH"
export SYSFS_PATH="$tmpdir/sys"
export GUESSDIR="$tmpdir/guess"

. guess-functions

guess_device "/devices/pci0000:00/0000:00:01.0/block/sda/sda1"
guess_device "/devices/pci0000:00/0000:00:01.0/block/sda/sda2"

cat "$GUESSDIR/guess.tsv"
