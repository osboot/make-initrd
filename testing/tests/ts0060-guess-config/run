#!/bin/bash -efu
# SPDX-License-Identifier: GPL-3.0-or-later

tmpdir="$(mktemp -d)"
trap 'rm -rf "$tmpdir"' EXIT

mkdir -p "$tmpdir/bin" "$tmpdir/guess"
cat > "$tmpdir/bin/depinfo" <<EOF
#!/bin/sh
echo "e1000e"
EOF
chmod +x "$tmpdir/bin/depinfo"

export GUESSDIR="$tmpdir/guess"
export RESOLVE_MODALIAS=1
export KERNEL=6.6.1
export PATH="$tmpdir/bin:$PWD/.build/dest/usr/bin:$PWD/.build/dest/usr/sbin:$PWD/tools:$PATH"

cat > "$GUESSDIR/guess.tsv" <<'EOF'
variable	TEST_VAR	val1 val2	-	-
module	add	ext4	storage	-
modalias	add	pci:v00008086d000010D3sv*sd*bc*sc*i*	nic	-
modalias	rescue	usb:v1234p5678	hid	-
opt-module	add	virtio_balloon	mem	-
feature	network	net	-	-
EOF

tools/guess-config
